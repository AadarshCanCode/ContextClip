# ContextClip local runtime settings
CONTEXTCLIP_DATA_DIR=./contextclip_data
CONTEXTCLIP_COPY_SETTLE_MS=120
CONTEXTCLIP_POLL_CLIPBOARD_MS=250
CONTEXTCLIP_MAX_CHARS=50000
CONTEXTCLIP_SCREENSHOT_MODE=active_window
CONTEXTCLIP_BUBBLE_ANALYZER=openrouter
CONTEXTCLIP_BUBBLE_AUTO_HIDE_MS=12000
CONTEXTCLIP_API_PORT=8765

# OpenRouter compression
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_ANALYZER_MODEL=openai/gpt-4o-mini
OPENROUTER_ACTION_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_TITLE=ContextClip
OPENROUTER_SITE_URL=https://contextclip.local

# Exa clipboard reference search
EXA_API_KEY=
EXA_SEARCH_TYPE=auto
EXA_NUM_RESULTS=10

# Google Calendar actions
# Leave blank to use local credentials.json/credential.json or the bubble checkout credentials.
CONTEXTCLIP_GOOGLE_CREDENTIALS=
CONTEXTCLIP_GOOGLE_TOKEN=
CONTEXTCLIP_CALENDAR_TIMEZONE=Asia/Kolkata

# HyperFrames demos (demos/hyperframes/)
# PostHog write-only ingest key for telemetry (get one at https://posthog.com)
POSTHOG_API_KEY=
VITE_POSTHOG_API_KEY=
# HeyGen OAuth client ID for hyperframes CLI auth
HYPERFRAMES_OAUTH_CLIENT_ID=

# HyperFrames demos
POSTHOG_API_KEY=
VITE_POSTHOG_API_KEY=
HYPERFRAMES_OAUTH_CLIENT_ID=
